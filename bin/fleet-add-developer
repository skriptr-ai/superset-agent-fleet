#!/usr/bin/env bash
# Give a developer a key to the public fleet view, in Doppler: one key for all their machines.
#
#   bin/fleet-add-developer <slug> "<Name>"        e.g. bin/fleet-add-developer jonas "Jonas"
#
# Makes the config `prd_<slug>` under `prd` in the `agent-fleet` project, with the key, the
# name over their door and the address to report to; and registers the key's hash with the
# cloud's store, which the cloud consults on every report — so there is nothing to redeploy.
# Re-running it keeps the existing key. The key itself is never printed and never stored
# anywhere but the developer's own config.
#
# Then, on each of the developer's machines: clone this repository and
#   ./service/install.sh --doppler prd_<slug>          (macOS)
#   ./service/install-linux.sh prd_<slug>              (Linux)
set -euo pipefail

slug="${1:-}"
name="${2:-}"
[[ "$slug" =~ ^[a-z][a-z0-9-]*$ && -n "$name" ]] || {
  echo "usage: $0 <slug> \"<Name>\"   (slug: lowercase letters, digits, dashes)" >&2
  exit 1
}
project=agent-fleet
config="prd_$slug"

# The config, if it is not there yet.
if ! doppler configs get "$config" -p "$project" >/dev/null 2>&1; then
  doppler configs create "$config" -p "$project" -e prd >/dev/null
  echo "created config $config"
fi

# The key: kept if one exists, so a re-run cannot lock out a machine already reporting.
key="$(doppler secrets get AGENT_FLEET_PUSH_KEY --plain -p "$project" -c "$config" 2>/dev/null || true)"
if [[ -z "$key" ]]; then
  key="$(openssl rand -hex 32)"
  echo "minted a key for $slug"
fi
doppler secrets set -p "$project" -c "$config" --silent \
  AGENT_FLEET_PUSH_KEY="$key" AGENT_FLEET_OWNER="$name"

# Its hash into the cloud's store, under the slug, with the name over the door.
hash="$(printf '%s' "$key" | shasum -a 256 | cut -d' ' -f1)"
url="$(doppler secrets get SUPABASE_URL --plain -p "$project" -c prd)"
srk="$(doppler secrets get SUPABASE_SERVICE_ROLE_KEY --plain -p "$project" -c prd)"
body="$(jq -nc --arg l "$slug" --arg h "$hash" --arg o "$name" '{p_label: $l, p_hash: $h, p_owner: $o}')"
code="$(curl -s -o /dev/null -w '%{http_code}' -X POST "$url/rest/v1/rpc/fleet_key_set" \
  -H "apikey: $srk" -H 'content-type: application/json' -d "$body")"
[[ "$code" == 2* ]] || { echo "the cloud's store answered $code registering the key" >&2; exit 1; }
echo "$name is registered as '$slug'; their machines use: --doppler $config"
