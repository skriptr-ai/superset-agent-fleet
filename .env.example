# Optional. Copy to .env in the repository root; Bun loads it automatically.
# The quickstart works without this file. Never put real credentials in examples.

AGENT_FLEET_PORT=4400
AGENT_FLEET_BIND=127.0.0.1
AGENT_FLEET_SCOPE=host

# Optional display name. Leave unset to use the Superset host's name.
# AGENT_FLEET_OWNER=Alex

# The scene follows this location's time, daylight, and forecast.
AGENT_FLEET_PLACE=Oslo
AGENT_FLEET_TZ=Europe/Oslo
AGENT_FLEET_LAT=59.9139
AGENT_FLEET_LON=10.7522
# Set off to disable requests to the weather provider.
AGENT_FLEET_WEATHER=on

# Optional: path to the Superset CLI, or force its slower but supported transport.
# SUPERSET_CLI=/absolute/path/to/superset
# SUPERSET_TRANSPORT=cli
