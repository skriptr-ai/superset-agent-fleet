<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.skriptr.superset-agent-fleet</string>

  <!-- Absolute paths on purpose: launchd gives jobs no shell and a bare PATH. -->
  <key>ProgramArguments</key>
  <array>
    <string>__BUN__</string>
    <string>server.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- The server spawns `superset`, which must be findable from here, not from your zshrc. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/superset-agent-fleet.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/superset-agent-fleet.log</string>
</dict>
</plist>
